{
  "name": "pennyboi",
  "version": "0.1.0",
  "private": true,
  "description": "Pennyboi the Almighty — a sandbox, fee-powered autonomous meme-coin experiment on Solana (devnet).",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test:program": "anchor test",
    "eyes": "pnpm --filter @pennyboi/eyes start",
    "brain": "pnpm --filter @pennyboi/brain start",
    "hands": "pnpm --filter @pennyboi/hands start",
    "mouth": "pnpm --filter @pennyboi/mouth start"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "tsx": "^4.16.0"
  }
}
