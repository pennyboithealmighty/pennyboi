# Pennyboi the Almighty — environment template
# Copy to `.env` and fill in. `.env` is gitignored and must NEVER be committed.
# DEVNET ONLY until the operator explicitly says "mainnet".

# ============================================================
# Solana / chain (shared by eyes, hands, scripts)
# ============================================================
# Cluster must stay "devnet" for v0.1. A mainnet value is a deliberate,
# operator-only change and is intentionally not provided here.
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# Deployed program + token. Filled in after `anchor deploy` (scripts/deploy).
VAULT_PROGRAM_ID=
TOKEN_MINT=

# Keypairs. Devnet only. Paths to JSON keypair files kept OUTSIDE the repo
# (e.g. ~/.config/solana/...). Never commit a keypair; keypairs/ is gitignored.
# AGENT = Pennyboi's restricted signer (hands). ADMIN = deploy/escape-hatch only.
AGENT_KEYPAIR_PATH=
ADMIN_KEYPAIR_PATH=

# Solscan base used when building public tx links (mouth). ?cluster=devnet appended.
SOLSCAN_BASE=https://solscan.io

# ============================================================
# Eyes (Helius webhook receiver + briefing builder)
# ============================================================
# If HELIUS_API_KEY is empty, eyes falls back to RPC polling.
HELIUS_API_KEY=
# Shared secret used to verify inbound Helius webhook calls (set in Helius dashboard).
HELIUS_WEBHOOK_SECRET=
# Port the webhook receiver listens on.
EYES_PORT=8787
# Polling interval (seconds) used only when no Helius key is present.
EYES_POLL_INTERVAL_SECS=30
# Where Eyes forwards each briefing (the Brain's /decide endpoint). Optional:
# if unset, Eyes only logs the briefing.
BRAIN_URL=http://127.0.0.1:8788/decide

# ============================================================
# Brain (LLM decision call)
# ============================================================
ANTHROPIC_API_KEY=
# Model id is env-driven so it can change without code edits. Latest Sonnet-class.
ANTHROPIC_MODEL=claude-sonnet-5-5
# High temp for narration flavor; output is still parsed as strict JSON.
BRAIN_TEMPERATURE=0.9
# Max tokens for the decision response.
BRAIN_MAX_TOKENS=1024
# Port the Brain's HTTP endpoint listens on (POST /decide).
BRAIN_PORT=8788
# Where the Brain forwards a validated decision (the Hands endpoint). Optional:
# if unset, the Brain only returns the decision to its caller.
HANDS_URL=http://127.0.0.1:8789/execute

# ============================================================
# Hands (validator + signer + submit)
# ============================================================
# Global kill switch mirror of Telegram /pause. "true" blocks all on-chain actions.
ACTIONS_PAUSED=false
# Confirmation level to wait for after submit: processed | confirmed | finalized
TX_COMMITMENT=confirmed
# Port the Hands HTTP endpoint listens on (POST /execute, /pause, /resume).
HANDS_PORT=8789
# Where Hands forwards the result for narration (the Mouth endpoint). Optional:
# if unset, Hands only logs the result.
MOUTH_URL=http://127.0.0.1:8790/narrate

# ============================================================
# Mouth — Telegram (the 6 values from docs/07; owner fills these in)
# ============================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
TELEGRAM_CHAT_ID=
TELEGRAM_TOPIC_GENERAL=
TELEGRAM_TOPIC_OFFERINGS=
TELEGRAM_TOPIC_SCRIPTURE=
# Reply rate limit: at most one in-character reply per topic per N seconds.
TELEGRAM_REPLY_RATE_SECS=90

# ============================================================
# Mouth — X / Twitter (official v2 API). Set X_ENABLED=false to disable posting.
# ============================================================
X_ENABLED=false
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# ============================================================
# Database (SQLite via better-sqlite3)
# ============================================================
DATABASE_PATH=./db/pennyboi.db

# ============================================================
# Automation (scripts/sweep cron + scripts/mock-fee-feed)
# ============================================================
# How often the permissionless sweep() is called (seconds).
SWEEP_INTERVAL_SECS=300
# Mock fee feed (devnet dry run): lamports dripped per tick into the FeeReceiver PDA.
MOCK_FEE_LAMPORTS=50000000
MOCK_FEE_INTERVAL_SECS=60

# ============================================================
# Misc
# ============================================================
LOG_LEVEL=info
